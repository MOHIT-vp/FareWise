        android:fillColor="#FFFFFF"
        android:pathData="M36,74m-7,0a7,7 0,1 1,14 0a7,7 0,1 1,-14 0" />
    <path
        android:fillColor="#4B4BF0"
        android:pathData="M36,74m-3,0a3,3 0,1 1,6 0a3,3 0,1 1,-6 0" />

